{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nm-domain",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "NmDomainContainer",
			"image": "./Dockerfile",
			"max_instances": 1,
			"instance_type": "basic"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "NmDomainContainer",
				"name": "NM_DOMAIN"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": ["NmDomainContainer"],
			"tag": "v1"
		}
	]
}
